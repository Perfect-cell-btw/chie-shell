{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "kitty",
    "source": "@HOME@/.config/chie-shell/assets/icons/icon.jpg",
    "width": 22,
    "height": 11,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },

  "display": {
    "separator": "  ",
    "key": {
      "width": 10
    }
  },

  "modules": [
    {
      "type": "custom",
      "format": "✦  @HOSTNAME@"
    },

    {
      "type": "os",
      "key": "󰣇 OS"
    },

    {
      "type": "kernel",
      "key": "󰌽 Kernel"
    },

    {
      "type": "uptime",
      "key": "󰔛 Up"
    },

    {
      "type": "cpu",
      "key": " CPU"
    },

    {
      "type": "gpu",
      "key": "󰢮 GPU"
    },

    {
      "type": "memory",
      "key": "󰍛 RAM"
    },

    {
      "type": "disk",
      "key": "󰋊 Disk",
      "folders": "/"
    },

    {
      "type": "display",
      "key": "󰍹 Display"
    },

    {
      "type": "wm",
      "key": "󱂬 WM"
    },

    {
      "type": "shell",
      "key": " Shell"
    },

    {
      "type": "terminal",
      "key": " Term"
    }
  ]
}
